# Generate each token separately: openssl rand -hex 32
# API_TOKEN is mandatory. Never reuse it as the ingress credential.
API_TOKEN=
API_READ_TOKEN=
INGRESS_TOKEN=
PORT=8099
BIND_ADDRESS=0.0.0.0
PUID=1000
PGID=1000
SYNC_INTERVAL=300
# true when every browser entry point uses HTTPS (HA ingress / reverse proxy).
COOKIE_SECURE=false
# CORS is unnecessary for iOS URLSession and same-origin UI/ingress.
CORS_ORIGINS=[]
# JSON mapping; prefixes must end in /. Mount these paths read-only in compose.
# ARTWORK_MOUNTS='{"smb://nas/media/posters/":"/artwork/"}'
ARTWORK_MOUNTS={}
