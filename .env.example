# Generate each token separately: openssl rand -hex 32
# API_TOKEN is mandatory. Never reuse it as the ingress credential.
API_TOKEN=
API_READ_TOKEN=
INGRESS_TOKEN=
PORT=8099
BIND_ADDRESS=0.0.0.0
PUID=1000
PGID=1000
# Automatic sync is triggered by web/iOS on open, only if the last
# successful Kodi-to-MariaDB import is older than 24 hours.
SCHEDULER_ENABLED=false
# Legacy periodic scheduler (only used if explicitly enabled above):
SYNC_INTERVAL=86400
# true when every browser entry point uses HTTPS (HA ingress / reverse proxy).
COOKIE_SECURE=false
# CORS is unnecessary for iOS URLSession and same-origin UI/ingress.
CORS_ORIGINS=[]
# JSON mapping; prefixes must end in /. Mount these paths read-only in compose.
# ARTWORK_MOUNTS='{"smb://nas/media/posters/":"/artwork/"}'
ARTWORK_MOUNTS={}

# Optional: TMDB API Read Access Token or API v3 key (kept on the server).
# https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=
# Optional: JSON CIDR arrays. Empty keeps authentication mandatory everywhere.
# LOCAL_AUTH_NETWORKS='["192.168.1.0/24","fd12:3456::/64"]'
LOCAL_AUTH_NETWORKS=[]
# Only actual reverse proxies that append/replace X-Forwarded-For correctly.
# Never add the whole LAN or Docker bridge just to bypass authentication.
# TRUSTED_PROXY_NETWORKS='["172.18.0.2/32"]'
TRUSTED_PROXY_NETWORKS=[]

# Optional on Linux/Synology if Docker hides the client behind its gateway IP.
# Host networking preserves client IPs for direct access at http://NAS:PORT.
# COMPOSE_FILE=compose.host.yaml:compose.dns.yaml

# Optional: used only with compose.dns.yaml. Choose your LAN resolver if needed.
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=8.8.8.8

# Bonjour/mDNS advertisement, for iOS local-network server discovery.
# Requires Docker host networking on Synology for multicast to reach the LAN.
# Use COMPOSE_FILE=compose.host.yaml:compose.dns.yaml and set PORT accordingly.
DISCOVERY_ENABLED=false
DISCOVERY_NAME=Home Kodi Library
# Defaults to PORT. Override if the externally reachable port differs.
# DISCOVERY_PORT=8099
